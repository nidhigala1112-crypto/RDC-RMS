# Copy this file to .env and fill in real values before deploying anywhere
# other than your own laptop.

# Required in production — a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional — defaults to 3000
PORT=3000

# Set to "production" when deploying so the server warns if SESSION_SECRET is missing
NODE_ENV=development

# Weekly Position Tracker email (sent Mondays, or on-demand via the "Send Now"
# button in Settings). Uses Gmail SMTP — you'll need a Google App Password,
# not your regular Gmail password:
#   1. Turn on 2-Step Verification on the Google account that will send these:
#      https://myaccount.google.com/security
#   2. Go to https://myaccount.google.com/apppasswords, create one for "Mail",
#      and paste the 16-character password below (no spaces).
# Recipients are set separately, in the app's Settings screen (email_recipients).
SMTP_USER=
SMTP_PASS=

# Google Meet link generation for interviews (via Google Calendar API).
# One-time setup in Google Cloud Console (console.cloud.google.com):
#   1. Create a project (or use an existing one).
#   2. APIs & Services > Library > enable "Google Calendar API".
#   3. APIs & Services > OAuth consent screen > User Type "External" >
#      fill in the required fields > under "Test users", add the Gmail
#      account you'll connect in step 5 below.
#   4. APIs & Services > Credentials > Create Credentials > OAuth client ID >
#      Application type "Web application" > under "Authorized redirect URIs"
#      add: http://localhost:3000/api/google/oauth/callback
#      (change the port if you run this app on a different one).
#      Copy the Client ID and Client Secret it gives you below.
#   5. Start the app, log in as a super_admin, go to Settings, and click
#      "Connect Google Calendar" — sign in with the same Google account you
#      added as a test user above, and approve access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Timezone used for interview Meet events (IANA name). Defaults to
# Asia/Kolkata if not set — only change this if your team isn't in India.
APP_TIMEZONE=Asia/Kolkata

# The web address your team uses to open this tracker. Used to build the links
# you send out (interviewer scorecard links and the Google sign-in return
# address). Leave blank while you only run it on your own computer
# (it then uses http://localhost:3000). Example: https://recruit.example.com
APP_BASE_URL=
